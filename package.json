{
  "name": "teachers-agenda",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "dev": "concurrently npm:dev:local npm:firebase",
    "dev:local": "vite",
    "dev:expose": "vite --host",
    "firebase": "firebase emulators:start --import emulator_data --export-on-exit emulator_data --config firebase.json",
    "format": "prettier --write --experimental-cli src/",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:firebase": "firebase emulators:start --import emulator_data_test --config firebase-test.json",
    "test:integration": "wait-on tcp:4000 && vitest --max-concurrency=1",
    "test:full": "npm-run-all --parallel test:firebase test:integration"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.14.4",
    "@schedule-x/calendar-controls": "^2.13.0",
    "@schedule-x/drag-and-drop": "^2.13.0",
    "@schedule-x/event-modal": "^2.13.0",
    "@schedule-x/events-service": "^2.13.0",
    "@schedule-x/theme-default": "^2.13.0",
    "@schedule-x/vue": "^2.12.0",
    "@vee-validate/yup": "^4.15.0",
    "firebase": "^12.11.0",
    "pinia": "^3.0.4",
    "tinycolor2": "^1.6.0",
    "uuid": "^11.1.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "vue3-toastify": "^0.2.8",
    "vuedraggable": "^4.1.0",
    "vuefire": "^3.2.2",
    "vuetify": "^4.0.3"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.11.0",
    "@types/tinycolor2": "^1.4.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "firebase-mock": "^2.3.2",
    "firebase-tools": "^15.11.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5",
    "wait-on": "^8.0.2"
  }
}
